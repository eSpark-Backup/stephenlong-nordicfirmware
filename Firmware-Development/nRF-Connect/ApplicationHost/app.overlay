
&pinctrl {
	com_uart_default: com_uart_default {
		group1 {
			psels = <NRF_PSEL(UART_TX, 0, 5)>, // TX as per the nrf52840 Host Board schematic
				<NRF_PSEL(UART_RX, 0, 3)>, // RX as per the nrf52840 Host Board schematic
				<NRF_PSEL(UART_RTS, 0, 6)>,
				<NRF_PSEL(UART_CTS, 0, 7)>;
		};
	};

	com_uart_sleep: com_uart_sleep {
		group1 {
			psels = <NRF_PSEL(UART_TX, 0, 5)>, // TX as per the nrf52840 Host Board schematic
				<NRF_PSEL(UART_RX, 0, 3)>, // RX as per the nrf52840 Host Board schematic
				<NRF_PSEL(UART_RTS, 0, 6)>,
				<NRF_PSEL(UART_CTS, 0, 7)>;
			low-power-enable;
		};
	};

};


&uart1 {
    status = "okay";
    current-speed = <115200>;
    pinctrl-0 = <&com_uart_default>;
    pinctrl-1 = <&com_uart_sleep>;
    pinctrl-names = "default", "sleep";
};